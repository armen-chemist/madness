# Structure optimization only: the ropt_* jobs of 17_H3_triangle_tilt_B425.jobs, same settings, on their own node,
# so the optimized geometries come without waiting for the R scan (the scan is the independent check).
# Written by hand (not by tools/make_jobs.py).
COMMON B=425.5 k=10 thresh=1e-6 eprec=1e-9 L=8 qextra=10 h=0.25 tmin=1e-8 tmax_factor=45 dphi=3 inner=3 tolscf=1e-5 rcut=1.0 rtaper=0.1 maxscf=40
ropt_x30_a0.30  nelec=3 state=highspin axial=0 mloc=0 E0=207 ropt=1 maxgeo=10 gtol=2e-3 rtol=1e-4 dr0=0.02 maxstep=0.05 "atoms=1,0.173205,0,0;1,-0.086603,0.129904,0.075;1,-0.086603,-0.129904,-0.075"
ropt_x60_a0.30  nelec=3 state=highspin axial=0 mloc=0 E0=207 ropt=1 maxgeo=10 gtol=2e-3 rtol=1e-4 dr0=0.02 maxstep=0.05 "atoms=1,0.173205,0,0;1,-0.086603,0.075,0.129904;1,-0.086603,-0.075,-0.129904"
ropt_x90_a0.30  nelec=3 state=highspin axial=0 mloc=0 E0=207 ropt=1 maxgeo=10 gtol=2e-3 rtol=1e-4 dr0=0.02 maxstep=0.05 "atoms=1,0.173205,0,0;1,-0.086603,0,0.15;1,-0.086603,0,-0.15"
ropt_y90_a0.30  nelec=3 state=highspin axial=0 mloc=0 E0=207 ropt=1 maxgeo=10 gtol=2e-3 rtol=1e-4 dr0=0.02 maxstep=0.05 "atoms=1,0,0,-0.173205;1,0,0.15,0.086603;1,0,-0.15,0.086603"
