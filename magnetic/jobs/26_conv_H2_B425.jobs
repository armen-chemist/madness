H2_L6         nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" L=6
H2_L12        nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" L=12
H2_q20        nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" qextra=20
H2_q40        nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" qextra=40
H2_rcut1.0    nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" rcut=1.0 rtaper=0.1
H2_rcut1.34   nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" rcut=1.34 rtaper=0.134
H2_rtaper0.2  nelec=2 state=triplet axial=1 ma=0 mb=-1 E0=203.5 E0b=207.7 tolscf=1e-7 maxscf=40 "atoms=1,0,0,-0.118376;1,0,0,0.118376" rtaper=0.2
