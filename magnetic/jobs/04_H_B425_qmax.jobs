# H atom, B = 425.5 B0: Fourier cutoff at strong field, rcut 0.65: qmax = 190 + (qextra - 10).
# compare with files 03 and 10.
# Summary: bash summarize.sh results/04_H_B425_qmax
COMMON B=425.5 E0=207 thresh=1e-7 L=4 rcut=0.65 rtaper=0.065 k=10 eprec=1e-9 tol=1e-7 maxiter=20 h=0.25 tmin=1e-8 tmax_factor=45 dphi=3
qextra10   qextra=10
qextra50   qextra=50
qextra100  qextra=100
qextra150  qextra=150
qextra200  qextra=200
